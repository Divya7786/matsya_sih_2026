# SAMUDRA AI Environment Configuration
# Copy this to .env and fill in required values

# === REQUIRED ===
# Google Gemini API key (for optional NL response enrichment)
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL ===
# ML Service URL (RandomForest PFZ model)
ML_SERVICE_URL=http://localhost:8000

# App URL (for Cloud Run / production deployment)
APP_URL=http://localhost:3000

# Server port
PORT=3000

# === AUTHENTICATION ===
# JWT signing secret — change this in production!
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# === DATABASE (optional — omit for in-memory dev mode) ===
# PostgreSQL connection string. If not set, users/history are stored in-memory (resets on restart).
# DATABASE_URL=postgresql://user:password@localhost:5432/matsya_ai
# Example for Neon/Supabase/Railway: DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# === EMAIL NOTIFICATIONS (optional — alerts log to console if not configured) ===
# Supported providers: sendgrid, mailgun
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=your_sendgrid_or_mailgun_api_key
# EMAIL_FROM=noreply@matsya.ai
# EMAIL_DOMAIN=mg.yourdomain.com  # required for Mailgun only

# === SMS NOTIFICATIONS (optional — reserved for future use) ===
# SMS_PROVIDER=twilio
# SMS_API_KEY=your_sms_api_key
# SMS_FROM=+91XXXXXXXXXX

# === LIVE DATA SOURCES (all public, NO API keys needed) ===
# Open-Meteo Marine: https://marine-api.open-meteo.com/v1/marine (free, no auth)
# NCEI ERDDAP SST: https://www.ncei.noaa.gov/erddap/ (free, no auth)
# PIFSC ERDDAP Chlorophyll: https://oceanwatch.pifsc.noaa.gov/erddap/ (free, no auth)
# INCOIS ERDDAP: https://erddap.incois.gov.in/erddap/ (free, no auth)
# No API keys required for any ocean/weather data source.
